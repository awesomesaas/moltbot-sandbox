# Copy this to .dev.vars and fill in your values
# .dev.vars is gitignored and used by wrangler dev

ANTHROPIC_API_KEY=sk-ant-...

# Local development mode - skips Cloudflare Access auth and bypasses device pairing
# DEV_MODE=true

# E2E test mode - skips Cloudflare Access auth but keeps device pairing enabled
# Use this for automated tests that need to test the real pairing flow
# E2E_TEST_MODE=true

# Enable debug routes at /debug/* (optional)
# DEBUG_ROUTES=true

# Optional - set a fixed token instead of auto-generated
MOLTBOT_GATEWAY_TOKEN=dev-token-change-in-prod

# Cloudflare Access configuration for /_admin and /api routes
# Required for admin UI and device pairing API in production
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag

# Optional chat channels
# TELEGRAM_BOT_TOKEN=optional
# DISCORD_BOT_TOKEN=optional

# CDP (Chrome DevTools Protocol) configuration for browser automation
# CDP_SECRET=shared-secret-for-cdp-auth
# WORKER_URL=https://your-worker.example.com

# ---------------------------------------------------------------------------
# Sales Coaching module (optional)
# Requires a D1 binding named SALES_DB in wrangler.jsonc (see README).
# The AI coaching uses the same ANTHROPIC_API_KEY / AI_GATEWAY_* above.
# ---------------------------------------------------------------------------
# CRM source: mock (default, works out of the box) | hubspot | salesforce
# SALES_CRM_PROVIDER=mock
# HUBSPOT_ACCESS_TOKEN=pat-...            # required when SALES_CRM_PROVIDER=hubspot
# SALES_COACH_MODEL=claude-opus-4-8       # Anthropic model for coaching
# Targets/thresholds (override the defaults in src/sales/config.ts):
# SALES_QUOTA_ATTAINMENT_TARGET=0.9
# SALES_PIPELINE_COVERAGE_TARGET=3
# SALES_CLOSE_RATE_TARGET=0.2
# SALES_PROPOSALS_TARGET=4
# SALES_PROFIT_MARGIN_TARGET=0.25
# SALES_PIP_AFTER_WEEKS=3                 # consecutive at-risk weeks before a PIP
# SALES_PIP_DURATION_WEEKS=6
# SALES_DEFAULT_WEEKLY_QUOTA=20000        # used by the HubSpot adapter
# Call analytics (talk-ratio coaching trigger):
# SALES_CALL_PROVIDER=mock                # mock (default) | zoom | google_meet | none
# SALES_TALK_RATIO_THRESHOLD=0.65
# ZOOM_ACCOUNT_ID=...                     # required when SALES_CALL_PROVIDER=zoom
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...
# GOOGLE_MEET_ACCESS_TOKEN=...            # required when SALES_CALL_PROVIDER=google_meet
